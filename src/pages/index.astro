---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>A/addin 2.0 — coming soon</title>
    <meta name="description" content="A/addin 2.0 — a local-first autonomous AI operator. Coming soon." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-neutral-900 font-mono">
    <main class="min-h-screen flex items-center justify-center px-6">
      <div class="text-center space-y-6">
        <div class="text-5xl font-semibold tracking-tight">
          <span class="text-7xl">A</span><span class="text-neutral-400 font-normal">/</span>addin<span class="align-super text-xs text-neutral-500 ml-1">2.0</span>
        </div>
        <div class="text-neutral-500 text-xs uppercase tracking-widest">
          a local-first autonomous AI operator
        </div>
        <div class="border border-neutral-900 inline-block px-5 py-3 text-xs tracking-wider">
          coming soon · phase 1
        </div>
        <div class="text-neutral-400 text-xs pt-8">
          presented by tanyewhong.com
        </div>
      </div>
    </main>
  </body>
</html>
